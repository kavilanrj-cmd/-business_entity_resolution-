# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Trained model artifacts (regenerate with `python -m scripts.train`)
models/
*.joblib
*.pkl

# Generated reports and submission output (regenerate with the scripts)
output/
reports/*
# ...except the architecture design document, which is hand-written and records
# the measured results, so it needs to be versioned. The exclusion has to be
# reports/* rather than reports/ because git does not descend into a directory
# it has already excluded, which would make the negation below a no-op.
!reports/scalable_architecture.md

# Real dataset (2.4 GB) and built artifacts (3 GB: store + index). The small
# placeholder TSVs under dataset/train and dataset/test stay tracked; the real
# files and everything under work/ are regenerated by scripts/build_store.py
# and scripts/build_index.py and must never be committed.
dataset/student_resource/
dataset/__MACOSX/
work/

# Notebooks are scratch exploration output
notebooks/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
